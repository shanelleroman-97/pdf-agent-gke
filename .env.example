# Copy to .env (gitignored), fill in, then `source .env`.
export PROJECT_ID=golden-veld-361718
export REGION=us-central1
export CLUSTER=pdf-agent

# Anthropic. The API key stays outside the sandboxes (dispatcher, stats
# adapter, Submit API). The environment key is the only credential a sandbox
# pod ever holds; generate it in the Console on the environment's page.
export ANTHROPIC_API_KEY=sk-ant-...
export ANTHROPIC_ENVIRONMENT_ID=env_...
export ANTHROPIC_ENVIRONMENT_KEY=sk-ant-oat01-...
export ANTHROPIC_AGENT_ID=agent_...

# Who may call the Submit API (comma-separated IAM members).
export SUBMIT_API_INVOKERS=user:you@example.com

# Overlay: 01_single_session for the first deploy, 02_autoscale for production.
export OVERLAY=01_single_session

export TF_VAR_project_id=${PROJECT_ID}
export TF_VAR_region=${REGION}
export TF_VAR_cluster_name=${CLUSTER}
